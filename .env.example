# Copy to `.env` and fill in. Every value can also be given as a JVM system property.
# The deploy writes the same keys to /opt/openrune-webserver/openrune.env — see deploy/README.md.

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────────
# The only required setting; the server will not start without it.
OPENRUNE_DATABASE_URL=jdbc:postgresql://localhost:5432/openrune
OPENRUNE_DATABASE_USER=openrune
OPENRUNE_DATABASE_PASSWORD=
# Two pools over one database: requests get a statement timeout, ingestion does not, so a long
# import can never starve the API.
# OPENRUNE_DATABASE_API_POOL=8
# OPENRUNE_DATABASE_INGEST_POOL=2
# OPENRUNE_DATABASE_STATEMENT_TIMEOUT_MS=15000

# ── Ingestion ────────────────────────────────────────────────────────────────────────────
# In production this is false: the scheduled job ingests in its own process, so a failed import
# cannot take the API with it. Set true only to run the worker inside the server.
# OPENRUNE_INGEST_ENABLED=false
# OPENRUNE_INGEST_MIN_REV=240          # lowest revision to ingest automatically
# OPENRUNE_INGEST_POLL_MS=60000
# OPENRUNE_INGEST_MAX_ATTEMPTS=3

# ── API ──────────────────────────────────────────────────────────────────────────────────
# Protects /admin/*. Unset means loopback clients only, which is not enough once the API is
# reachable through the tunnel.
# OPENRUNE_ADMIN_TOKEN=change-me
# Revisions kept warm in the response cache: the base revision plus this many newest.
# OPENRUNE_HOT_REVISIONS=2
# Rename sidebar sections, e.g. "worldentity=World Entities;spotanim=SpotAnim".
# OPENRUNE_NAV_DISPLAY_OVERRIDES=

# ── Cloudflare R2 / CDN ──────────────────────────────────────────────────────────────────
# Sprites, textures, models and rendered item/object images. Credentials are only needed to
# upload; serving needs just the bucket and public base URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openrune
R2_PUBLIC_BASE_URL=https://cdn.openrune.dev

OPENRUNE_CDN_BUCKET=openrune
OPENRUNE_CDN_BASE_URL=https://cdn.openrune.dev
OPENRUNE_CDN_REGION=auto
OPENRUNE_CDN_ENABLED=true
# Derived from R2_ACCOUNT_ID when unset.
# OPENRUNE_CDN_ENDPOINT=https://{accountId}.r2.cloudflarestorage.com
# Full-size sprites redirect to the CDN by default. Set false while the CDN is still being filled
# — PostgreSQL always has every sprite, the CDN only has what has been published to it.
# OPENRUNE_CDN_REDIRECT_SPRITES=true

# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read as a last fallback for the CDN credentials.
