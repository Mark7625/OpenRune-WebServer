# Cloudflare R2 / S3 sprite CDN — copy to `.env` and fill in.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=openrune
R2_PUBLIC_BASE_URL=https://cdn.openrune.dev

OPENRUNE_CDN_BUCKET=openrune
OPENRUNE_CDN_BASE_URL=https://cdn.openrune.dev
OPENRUNE_CDN_REGION=auto
# Or set OPENRUNE_CDN_ENDPOINT=https://{accountId}.r2.cloudflarestorage.com
OPENRUNE_CDN_ENABLED=true
OPENRUNE_SPRITES_IN_BIN=true
